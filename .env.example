# API Gateway Configuration

# Environment
NODE_ENV=development
PORT=8091

# Authentication Secrets
JWT_SECRET=your-secure-jwt-secret-key-change-in-production
SERVICE_SECRET=gateway-service-secret-change-in-production

# Microservice URLs
AUTH_URL=http://localhost:8092
MEDIA_URL=http://localhost:8093
NOTIFY_URL=http://localhost:8094
PAY_URL=http://localhost:8095
VPN_URL=http://localhost:8080

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Service Timeouts (milliseconds)
SERVICE_TIMEOUT=60000

# API Base URL
API_BASE_URL=http://localhost:8091
